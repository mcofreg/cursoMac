# ─────────────────────────────────────────────────────────────
# Faro — configuración de entorno
# Copiar a .env y ajustar. NUNCA versionar el .env real.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://faro:faro@localhost:5432/faro

# ── API ──────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────
# 'dev'  → proveedor OIDC embebido con usuarios de prueba
# 'oidc' → proveedor corporativo real (Entra ID / Google Workspace)
AUTH_MODE=dev

# Solo cuando AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# Secreto de firma de sesiones y JWT de dispositivo.
# Generar con: openssl rand -hex 32
SESSION_SECRET=cambiar-esto-por-un-valor-aleatorio-de-64-hex
DEVICE_TOKEN_TTL_HOURS=24

# ── Firma de contenido (ECDSA P-256) ─────────────────────────
# Generar con: pnpm keys:generate
SIGNING_PRIVATE_KEY_PATH=./keys/signing-private.pem
SIGNING_PUBLIC_KEY_PATH=./keys/signing-public.pem

# ── Almacenamiento de imágenes ───────────────────────────────
# 'local' → disco (prototipo)   |   's3' → S3/MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
ASSET_PUBLIC_URL=http://localhost:3000/assets

# ── Seguridad de contenido ───────────────────────────────────
# Dominios permitidos como destino de los botones de acción (CSV).
CTA_URL_ALLOWLIST=intranet.banco.cl,crm.banco.cl,www.banco.cl,localhost

# Orígenes donde la extensión puede inyectar (CSV).
# En producción: los dominios internos reales. Nunca <all_urls>.
INJECTION_ORIGINS=http://localhost:8080,https://intranet.banco.cl,https://crm.banco.cl

# ── Privacidad ───────────────────────────────────────────────
# true → el dashboard solo muestra métricas agregadas; se desactiva
# toda consulta a nivel individual sin tocar el código.
AGGREGATE_METRICS_ONLY=false
EVENT_RETENTION_DAYS=90

# ── Extensión ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
